---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/search/', label: '搜索' },
  { href: '/about/', label: '关于' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="深度思考首页">
    <span class="brand-mark" aria-hidden="true">深</span>
    <span class="brand-copy">
      <strong>深度思考</strong>
      <small>DEEP THOUGHT · T08</small>
    </span>
  </a>
  <nav aria-label="主导航">
    {links.map((link) => (
      <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <button class="theme-toggle" type="button" aria-label="切换深浅主题" title="切换主题">
    <span class="theme-icon" aria-hidden="true">◐</span>
  </button>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
